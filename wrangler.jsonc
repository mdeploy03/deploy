{
  // DEPLOY Werkruimte – Cloudflare Worker + D1 (EU)
  // Database-id's staan NIET in de code: GitHub Actions vult de
  // plaatshouders hieronder in vanuit repository-secrets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deploy-werkruimte",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
    "binding": "ASSETS"
  },

  // Lokaal (npm run dev): lokale D1, geen inlogscherm.
  "vars": { "ENVIRONMENT": "local" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deploy-werkruimte-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "env": {
    "staging": {
      "name": "deploy-werkruimte-staging",
      "vars": { "ENVIRONMENT": "staging" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "deploy-werkruimte-staging",
          "database_id": "__STAGING_D1_DATABASE_ID__",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "deploy-werkruimte",
      "vars": { "ENVIRONMENT": "production" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "deploy-werkruimte",
          "database_id": "__PRODUCTION_D1_DATABASE_ID__",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
